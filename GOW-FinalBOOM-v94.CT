<?xml version="1.0" encoding="utf-8"?>
<CheatTable CheatEngineTableVersion="52">
  <CheatEntries>
    <CheatEntry>
      <ID>143</ID>
      <Description>"Final BOOM v9.x [AOB] v1"</Description>
      <Color>FF8000</Color>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>//Author:  balenaucigasa
//Created: October 30, 2026

[ENABLE]
aobscanmodule(INJEhealth,GameAssembly.dll,89 47 10 8B 97 8C 00 00 00) // should be unique
alloc(newmem,$1000)
alloc(execCount,4)
alloc(lastTick,4)

label(skipZeroing)
label(resetCounter)
label(originalCode)
label(return)

newmem:
  pushad
  call GetTickCount

  // Verifică dacă este prima rulare de la activare
  mov edx, [lastTick]
  test edx, edx
  jz resetCounter

  // Calculează timpul scurs: timpul_curent (EAX) - timpul_vechi (EDX)
  sub eax, edx
  cmp eax, #8000          // Au trecut 8 secunde (8000 ms)?
  jl skipZeroing          // Dacă NU au trecut, mergem mai departe

resetCounter:
  // Dacă au trecut 8 secunde (sau e prima rulare), resetăm contorul la 0
  mov dword ptr [execCount], 0
  call GetTickCount       // Reîmprospătăm EAX cu timpul curent actualizat
  mov [lastTick], eax     // Salvăm noul timp ca punct de reper

skipZeroing:
  popad
  inc dword ptr [execCount]
  cmp dword ptr [execCount], 5
  jl originalCode         // Dacă execCount este mai mic decât 5, SARE peste transformarea în zero
  xor eax, eax            // Dacă a ajuns la 5 (sau mai mult), EAX devine 0

originalCode:
  mov [edi+10],eax
  mov edx,[edi+0000008C]
  jmp return

INJEhealth:
  jmp newmem
  nop 4
return:
registersymbol(INJEhealth)

[DISABLE]
INJEhealth:
  db 89 47 10 8B 97 8C 00 00 00

unregistersymbol(INJEhealth)
dealloc(newmem)
dealloc(execCount)
dealloc(lastTick)

//PuzzleTroop.Init

</AssemblerScript>
    </CheatEntry>
