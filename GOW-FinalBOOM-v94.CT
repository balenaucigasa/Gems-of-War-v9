    <CheatEntry>
      <ID>10</ID>
      <Description>"All Rewards v9.4"</Description>
      <Color>FF8000</Color>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
alloc(newmem,2048)
label(returnhere)
label(originalcode)
label(exit)

newmem: // Reward.AddGold
mov eax,(int)5
add [ecx+0C],00000064 //add more gold
add [ecx+14],(int)40  //40  //add more souls
add [ecx+20],(int)2   //add XP , Max is 10 but as a precaution, do not change the default value
add [ecx+18],(int)5   //add 5 keys, Max is 5
add [ecx+1C],(int)2   //add 2 Treasure Maps, Maxim is 10


originalcode:
add [ecx+10],eax      //add 5 gems, Max is 5
pop ebp
ret

exit:
jmp returnhere

"GameAssembly.dll"+3A689C:
jmp newmem
returnhere:


[DISABLE]
dealloc(newmem)
